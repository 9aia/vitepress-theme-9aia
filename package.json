{
  "name": "vitepress-theme-9aia",
  "version": "0.0.0",
  "description": "Rounded, blue (#00f) VitePress theme — the 9aia docs look.",
  "keywords": [
    "9aia",
    "vitepress",
    "vitepress-theme"
  ],
  "homepage": "https://github.com/9aia/vitepress-theme-9aia#readme",
  "bugs": {
    "url": "https://github.com/9aia/vitepress-theme-9aia/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/9aia/vitepress-theme-9aia.git"
  },
  "files": [
    "src",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./components": "./src/components/index.ts",
    "./style.css": "./src/style.css",
    "./tokens.css": "./src/tokens.css",
    "./base.css": "./src/base.css",
    "./patterns.css": "./src/patterns.css",
    "./vitepress.css": "./src/vitepress.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "test": "vp test",
    "check": "vp check"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitepress": "^1.6.4",
    "vue": "^3.5.0"
  },
  "peerDependencies": {
    "vitepress": ">=1.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  }
